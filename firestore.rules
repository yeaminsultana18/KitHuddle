rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function myRole() { return get(myDoc()).data.role; }
    function isOwner() { return signedIn() && exists(myDoc()) && myRole() == 'owner'; }
    function isAdmin() { return signedIn() && exists(myDoc()) && myRole() in ['admin', 'owner']; }
    function setupDone() { return exists(/databases/$(database)/documents/config/setup); }

    // The lock that makes owner setup a one-time action
    match /config/setup {
      allow read: if true;
      allow create: if signedIn() && !setupDone()
        && request.resource.data.ownerId == request.auth.uid
        && getAfter(myDoc()).data.role == 'owner';
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // New profiles: customers, or the one owner during setup
      allow create: if signedIn() && request.auth.uid == uid && (
        request.resource.data.role == 'customer'
        || (request.resource.data.role == 'owner' && !setupDone()
            && existsAfter(/databases/$(database)/documents/config/setup))
      );

      // Everyone edits their own profile, but never their own role
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;

      // The owner switches other users between customer and admin, and changes nothing else
      allow update: if isOwner() && request.auth.uid != uid
        && resource.data.role in ['customer', 'admin']
        && request.resource.data.role in ['customer', 'admin']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']);
    }

    // Anyone can see the catalog; only admins and the owner can change it
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }

    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();

      // Module 4: a signed-in customer placing an order may LOWER the stock, and change nothing else
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock;
    }

    // Module 4: orders
    match /orders/{orderId} {
      // Customers see their own orders; admins see all
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      // A customer creates their own order: cash on delivery, confirmed straight away
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'confirmed'
        && request.resource.data.paymentMethod == 'cash_on_delivery'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number;

      // Only admins change an order, and only its status
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['pending', 'confirmed', 'shipped', 'delivered', 'cancelled'];

      allow delete: if false;
    }

    // Module 4: notifications ('admin' = for all admins, otherwise a customer's uid)
    match /notifications/{id} {
      allow read: if signedIn() && (
        resource.data.to == request.auth.uid
        || (resource.data.to == 'admin' && isAdmin())
      );

      // Customers can notify the admins (a new order) or themselves (order confirmed); admins can notify anyone
      allow create: if signedIn()
        && request.resource.data.read == false
        && (request.resource.data.to == 'admin' || request.resource.data.to == request.auth.uid || isAdmin());

      // The person it is for may mark it as read, and change nothing else
      allow update: if signedIn() && (
          resource.data.to == request.auth.uid
          || (resource.data.to == 'admin' && isAdmin())
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      allow delete: if false;
    }

    // Module 6: each customer's wishlist (users/{uid}/wishlist/{productId})
    match /users/{uid}/wishlist/{productId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Module 5: squad orders
    match /squads/{squadId} {
      function squadOpen() {
        return get(/databases/$(database)/documents/squads/$(squadId)).data.status == 'open'
          && get(/databases/$(database)/documents/squads/$(squadId)).data.deadline > request.time;
      }
      function isCaptain() {
        return signedIn() && get(/databases/$(database)/documents/squads/$(squadId)).data.captainId == request.auth.uid;
      }

      // Anyone with the code can see the squad (no account needed to join)
      allow read: if true;

      // A signed-in captain creates an open squad
      allow create: if signedIn()
        && request.resource.data.captainId == request.auth.uid
        && request.resource.data.status == 'open';

      // The captain closes it when placing the order; admins can change anything
      allow update: if (signedIn() && resource.data.captainId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'orderId'])
          && request.resource.data.status == 'ordered')
        || isAdmin();

      allow delete: if isAdmin();

      // Members: the document id is the jersey number, so a number can only be taken once
      match /members/{number} {
        allow read: if true;
        allow create: if squadOpen()
          && request.resource.data.jerseyNumber == number
          && request.resource.data.name is string && request.resource.data.name.size() > 0
          && request.resource.data.jerseyName is string && request.resource.data.jerseyName.size() <= 12;
        allow delete: if (isCaptain() && squadOpen()) || isAdmin();
      }

      // Members' phone numbers: only the captain and admins can read them
      match /contacts/{number} {
        allow read: if isCaptain() || isAdmin();
        allow create: if squadOpen()
          && existsAfter(/databases/$(database)/documents/squads/$(squadId)/members/$(number));
        allow delete: if isCaptain() || isAdmin();
      }
    }

    // Help chat for the whole shop: chats/{chatId}
    //   signed-in customers: chatId = their uid
    //   guests: chatId = "guest-" + 32 random letters/numbers kept in their browser (works like a secret key)
    // Admins are the moderators.
    match /chats/{chatId} {
      function guestChat() { return chatId.matches('guest-[0-9a-f]{32}'); }
      function myChat() { return signedIn() && request.auth.uid == chatId; }

      allow get: if guestChat() || myChat() || isAdmin();
      allow list: if isAdmin(); // only admins see the list of all chats
      allow create, update: if guestChat() || myChat() || isAdmin();

      match /messages/{messageId} {
        allow read: if guestChat() || myChat() || isAdmin();
        allow create: if ((guestChat() || myChat()) && request.resource.data.from == 'user')
          || (isAdmin() && request.resource.data.from == 'admin');
      }
    }
  }
}
